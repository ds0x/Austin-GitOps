	</array>
	<key>PayloadDescription</key>
	<string>Hides major macOS upgrades (such as macOS 27) until 90 days after Apple releases them. Applies to Macs outside the macOS 27 beta testers label.</string>
	<key>PayloadDisplayName</key>
	<string>Defer major macOS upgrades</string>
	<key>PayloadIdentifier</key>
	<string>com.austinintentops.defer-major-updates</string>
	<key>PayloadOrganization</key>
	<string>Austin IntentOps</string>
	<key>PayloadRemovalDisallowed</key>
	<true/>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>0896B242-BE4A-422A-9EDA-5689D5C2D8FA</string>
