<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>forceDelayedMajorSoftwareUpdates</key>
			<true/>
			<key>enforcedSoftwareUpdateMajorOSDeferredInstallDelay</key>
			<integer>90</integer>
			<key>PayloadDisplayName</key>
			<string>Major update deferral</string>
